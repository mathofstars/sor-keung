{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sor-Keung",
  "version": "0.2.5",
  "identifier": "com.mathofstars.sor-keung",
  "build": {
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/sor-keung-sidecar"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
